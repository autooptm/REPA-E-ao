+def _opt_1(w):
+    out_c, in_c = w.shape[0], w.shape[1]
+    wt = w.new_zeros((in_c, out_c, 4, 4))
+    for kh in range(4):
+        for kw in range(4):
+            acc = 0.0
+            for a in _OPT_3[kh]:
+                for b in _OPT_3[kw]:
+                    acc = acc + w[:, :, a, b]
+            wt[:, :, kh, kw] = acc.transpose(0, 1)
+    return wt
